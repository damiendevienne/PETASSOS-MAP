# Admin authentication. Generate a local .env with backend/setup_admin.py.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Keep true for HTTPS production; use false only for local HTTP development.
SESSION_COOKIE_SECURE=true

# Production paths and replaceable external services.
BASE_URL=http://localhost:8000
DATA_DIR=./data
UPLOAD_DIR=./uploads
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
MAX_UPLOAD_MB=10
MAX_IMAGE_DIMENSION=2400
